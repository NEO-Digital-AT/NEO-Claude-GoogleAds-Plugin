# Zugangsdaten und Schutzgrenzen für den Container.
#
# Diese Datei nach .env kopieren und ausfüllen. Sie enthält dann Refresh
# Token, Client-Geheimnis und Developer Token im Klartext: Rechte 600,
# niemals ins Repository, niemals in eine Nachricht.
#
# Den fertigen Block liefert auf dem eigenen Rechner:
#     python google-ads-auth.py --env

# -- Adresse ------------------------------------------------------------
# Unter welcher Adresse der Browser diesen Server sieht. Setzen, wenn ein
# Reverse Proxy davorsteht - und das tut er hier.
#
# Ohne diese Zeile raet der Server die Adresse aus den Koepfen des Proxys.
# Plesks Docker-Proxy-Regeln schicken kein X-Forwarded-Proto, dann kaeme
# http:// heraus statt https:// - und Google lehnt die Rueckadresse fuer
# OAuth ab. Mit dieser Zeile ist nichts geraten.
GOOGLE_ADS_PUBLIC_URL=https://ads.mcp.neo-digital.at

# -- Erste Anmeldung am Portal -----------------------------------------
# Damit legt der Container beim allerersten Start das Verwaltungskonto an.
# Danach werden die beiden Zeilen nicht mehr gelesen: ein vorhandenes Konto
# wird nie ueberschrieben, umbenannt oder wiederhergestellt.
#
# Das Kennwort steht hier im Klartext. Deshalb verlangt das Portal bei der
# ersten Anmeldung sofort ein neues, und danach koennen beide Zeilen aus
# dieser Datei verschwinden.
#
# Fehlen sie, legt der erste Start ein Konto "admin" mit einem zufaelligen
# Kennwort an und schreibt es ins Bereitstellungsprotokoll.
INIT_USER=
INIT_PASS=

# -- Zugang ------------------------------------------------------------
# Diese vier kannst du auch leer lassen und stattdessen im Browser unter
# /setup eintragen. Wer sie hier setzt, spart den Schritt.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=5303457641
GOOGLE_ADS_API_VERSION=v25

# -- Schutzgrenzen -----------------------------------------------------
# Schreiben einschalten. Auch dann bleibt jeder Schreibaufruf zuerst ein
# Trockenlauf; scharf wird er erst, wenn im Gespräch ausdrücklich
# freigegeben wurde.
GOOGLE_ADS_ALLOW_WRITE=true

# In WELCHE Konten geschrieben werden darf. Leer wäre "alle zugänglichen" —
# das ist hier die falsche Antwort. Kommagetrennt, Bindestriche erlaubt.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=

# Höchstes Tagesbudget, das ein einzelnes Budget bekommen darf, in deiner
# Kontowährung. Nicht in Millionstel — 50 heißt fünfzig Euro.
GOOGLE_ADS_MAX_DAILY_BUDGET=50

# Größter Sprung eines Budgets in einem Schritt.
GOOGLE_ADS_MAX_BUDGET_INCREASE_FACTOR=2.0

# Operationen je Aufruf. Begrenzt den Schaden eines einzelnen Fehlgriffs.
GOOGLE_ADS_MAX_OPERATIONS_PER_CALL=100
