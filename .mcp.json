{
  "mcpServers": {
    "neo-google-ads": {
      "type": "stdio",
      "command": "${GOOGLE_ADS_PYTHON:-python3}",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/google-ads-mcp.py"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
